# ─── Backend API ─────────────────────────────────────────────────────────────
# Leave NEXT_PUBLIC_API_URL empty in production — next.config.ts proxies
# /api/* to BACKEND_URL server-side, so the browser only ever calls this same
# origin. Set BACKEND_URL to your backend's URL (e.g. your Render service).
NEXT_PUBLIC_API_URL=
BACKEND_URL=http://localhost:8000

# ─── Razorpay ────────────────────────────────────────────────────────────────
# Get from: razorpay.com → Settings → API Keys. This is the publishable
# key_id (safe to expose client-side, like a Stripe publishable key) — the
# matching secret lives only in the backend's RAZORPAY_KEY_SECRET, never here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# ─── Cloudflare Turnstile ────────────────────────────────────────────────────
# Get from: Cloudflare Dashboard → Turnstile → your widget → Site Key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── Test-mode payment UI toggle ─────────────────────────────────────────────
# Must be unset/false in production — shows a "Test Mode (Manual)" checkout
# button. The real authorization is enforced server-side by the backend's
# ALLOW_TEST_PAYMENTS flag; this only controls whether the button is shown.
NEXT_PUBLIC_ENABLE_TEST_PAYMENTS=false

# ─── Payment mode ────────────────────────────────────────────────────────────
# "manual" | "razorpay" | "both" — controls which checkout button(s) render.
# Razorpay's own code/buttons are untouched either way; this only toggles
# what's shown. Set to "manual" while there's no live Razorpay key yet, flip
# to "razorpay" (or "both") once there is — no code changes needed.
NEXT_PUBLIC_PAYMENT_MODE=manual

# ─── Canonical site URL ──────────────────────────────────────────────────────
# Anchors every canonical/og:url, the sitemap, robots.txt, and JSON-LD
# (src/lib/site.ts). Leave unset to fall back to whichever host is currently
# live; set this once the custom domain is ready — no code change needed.
NEXT_PUBLIC_SITE_URL=
